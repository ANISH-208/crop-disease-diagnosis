{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "crop-doctor-api": {
      "root": ".",
      "framework": "fastapi"
    },
    "crop-doctor-frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "crop-doctor-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "crop-doctor-frontend"
      }
    }
  ]
}
