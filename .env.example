# Backend runtime configuration. Export these variables before starting Uvicorn.
CROP_DOCTOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://crop-disease-diagnosis-three.vercel.app
CROP_DOCTOR_MAX_UPLOAD_BYTES=4194304
CROP_DOCTOR_MAX_IMAGE_PIXELS=40000000
CROP_DOCTOR_CONFIDENCE_THRESHOLD=80
# These thresholds must come from held-out calibration. Leave unset until validated.
# CROP_DOCTOR_DISEASE_MIN_PROBABILITY=
# CROP_DOCTOR_DISEASE_MIN_MARGIN=
# Required (32+ random characters) to enable expert alert endpoints. Keep this secret on the server.
CROP_DOCTOR_EXPERT_API_KEY=
# Optional path overrides:
# CROP_DOCTOR_UPLOAD_DIR=backend/uploads
# CROP_DOCTOR_DATABASE_PATH=backend/alerts.db
# CROP_DOCTOR_MODEL_PATH=models/crop_doctor_v6_efficientnetv2s.keras
# CROP_DOCTOR_LITE_MODEL_PATH=models/crop_doctor_v6_efficientnetv2s.tflite
# CROP_DOCTOR_SUITABILITY_MODEL_PATH=models/crop_suitability.tflite
